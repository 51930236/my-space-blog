 </style>
 
 <div class="home-banner-background transition-fade fixed top-0 left-0 w-screen h-screen scale-125 sm:scale-110 box-border will-change-transform bg-cover">
+    <% if (theme.home_banner.image.custom_style) { %>
+    <% const slideshow = theme.home_banner.image.slideshow || {}; %>
+    <% if (slideshow.enable && slideshow.list && slideshow.list.length > 0) { %>
+        <div class="slideshow-wrapper" data-interval="<%= slideshow.interval || 10 %>">
+        <% slideshow.list.forEach(function(img) { %>
+            <img src="<%- url_for(img) %>" alt="" class="slideshow-img w-full h-full object-cover">
+        <% }) %>
+        </div>
+    <% } else { %>
+        <img src="<%- url_for(theme.home_banner.image.light) %>" alt="home-banner-background" class="w-full h-full object-cover">
+    <% } %>
+    <div class="night-overlay"></div>
+<% } else { %>
     <img src="<%- url_for(theme.home_banner.image.light) %>" alt="home-banner-background" class="w-full h-full object-cover dark:hidden">
     <img src="<%- url_for(theme.home_banner.image.dark) %>" alt="home-banner-background" class="w-full h-full object-cover hidden dark:block">
+<% } %>
 </div>
+<% if (theme.home_banner.image.custom_style) { %>
+    <% const ss = theme.home_banner.image.slideshow || {}; %>
+    <% if (ss.enable && ss.list && ss.list.length > 0) { %>
+    <script data-swup-reload-script>
+    (function() {
+        var c = document.querySelector('.home-banner-background');
+        if (!c) return;
+        var w = c.querySelector('.slideshow-wrapper');
+        if (!w) return;
+        var imgs = w.querySelectorAll('.slideshow-img');
+        if (imgs.length < 2) return;
+        var interval = parseInt(w.getAttribute('data-interval')) * 1000 || 10000;
+        var current = 0;
+        imgs[0].classList.add('active');
+        setInterval(function() {
+            imgs[current].classList.remove('active');
+            current = (current + 1) % imgs.length;
+            imgs[current].classList.add('active');
+        }, interval);
+    })();
+    </script>
+    <% } %>
+<% } %>
 
